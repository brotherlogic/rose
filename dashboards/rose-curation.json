{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "title": "Artworks Annotated",
      "type": "stat",
      "description": "Curated vs Total images visualization.",
      "targets": [
        {
          "expr": "max(last_over_time(rose_syncer_artworks_annotated_total{namespace=\"rose\"}[7d]))",
          "legendFormat": "Curated Artworks",
          "refId": "A"
        },
        {
          "expr": "max(last_over_time(rose_syncer_photos_stored{namespace=\"rose\"}[7d]))",
          "legendFormat": "Total Stored Photos",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Annotation Failures",
      "type": "stat",
      "description": "Total vision annotation and parsing errors. Prominent red threshold highlight when value > 0.",
      "targets": [
        {
          "expr": "rose_syncer_annotation_errors_total{namespace=\"rose\"}",
          "legendFormat": "Failures",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "drawStyle": "line",
            "lineInterpolation": "linear"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 3,
      "title": "Annotation Latency",
      "type": "timeseries",
      "description": "Median (p50) and 95th percentile (p95) vision inference duration over time.",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(rose_syncer_annotation_duration_seconds_bucket{namespace=\"rose\"}[5m])) by (le))",
          "legendFormat": "p50 (Median)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rose_syncer_annotation_duration_seconds_bucket{namespace=\"rose\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 4,
      "options": {
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "pie",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "title": "Artistic Movement Breakdown",
      "type": "piechart",
      "description": "Distribution of artworks across artistic movements (including Uncategorized).",
      "targets": [
        {
          "expr": "topk(10, max by (theme) (last_over_time(rose_syncer_artistic_movements_total{namespace=\"rose\"}[7d])))",
          "legendFormat": "{{theme}}",
          "refId": "A"
        },
        {
          "expr": "(sum(max by (theme) (last_over_time(rose_syncer_artistic_movements_total{namespace=\"rose\"}[7d]))) - sum(topk(10, max by (theme) (last_over_time(rose_syncer_artistic_movements_total{namespace=\"rose\"}[7d]))))) > 0",
          "legendFormat": "Other",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "title": "Rose - AI Curation Overview",
  "uid": "rose-curation"
}
