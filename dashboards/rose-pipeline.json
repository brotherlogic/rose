      "targets": [
        {
          "expr": "(max(last_over_time(rose_syncer_photos_downloaded_total{namespace=\"rose\"}[7d])) / clamp_min(max(last_over_time(rose_syncer_photos_discovered_total{namespace=\"rose\"}[7d])), 1)) * 100 or vector(0)",
